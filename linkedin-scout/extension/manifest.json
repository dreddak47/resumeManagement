{
  "manifest_version": 3,
  "name": "LinkedIn Scout",
  "version": "0.1.0",
  "description": "Scans your LinkedIn feed on a timer, sorts posts with Jev, and opens matching job links.",
  "permissions": ["alarms", "tabs", "scripting", "storage", "notifications", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
